{
  "name": "slack-message-deleter",
  "version": "1.0.16",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run doctor",
    "doctor:node-version": "check-node-version --node '>=22' --npx 10 --npm 10",
    "doctor": "npm run doctor:node-version",
    "prettier": "prettier --write '**/*'",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "fmt": "npm run prettier && npm run lint-fix",
    "build": "tsc -p ./tsconfig.build.json",
    "test": "jest"
  },
  "bin": {
    "slack-message-deleter": "./bin/adapter/entry-points/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiromiShikata/npm-cli-slack-message-deleter.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HiromiShikata/npm-cli-slack-message-deleter/issues"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm"
    ],
    "branches": [
      "main"
    ]
  },
  "homepage": "https://github.com/HiromiShikata/npm-cli-slack-message-deleter#readme",
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/npm": "13.2.0",
    "@swc/core": "1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "check-node-version": "^4.2.1",
    "commitlint": "21.2.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jest": "30.5.2",
    "jest-html-reporter": "4.4.2",
    "jest-junit": "^17.0.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@slack/web-api": "8.2.0",
    "commander": "^15.0.0",
    "dotenv": "18.0.7"
  },
  "overrides": {
    "handlebars": "^4.7.10"
  }
